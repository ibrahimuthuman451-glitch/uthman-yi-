# ---------------------------------------------------------------------------
# Uthman IY platform - example environment file
# Copy to ".env" and fill in values. NEVER commit real secrets.
# All values below are development placeholders, not production credentials.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma and the application.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/uthmaniy?schema=public"

# Public site URL (no trailing slash). Used for canonical URLs, sitemap and
# Open Graph metadata. In production set this to the real domain.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret used to sign session/order-access tokens (min 32 characters).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"

# Seed credentials for the first administrator.
# The seed refuses to run in production without these being set explicitly.
ADMIN_EMAIL="admin@uthmaniy.local"
ADMIN_PASSWORD="ChangeMe-StrongP@ssw0rd!"
ADMIN_NAME="Uthman IY Administrator"

# Include clearly-labelled demonstration products in the seed?
# "true"  -> seeds demo listings marked DEMO (development / preview only)
# "false" -> no demo listings (recommended for production)
SEED_DEMO_PRODUCTS="true"

# ---------------------------------------------------------------------------
# Payments
# Only methods that are explicitly enabled AND fully configured are offered.
# ---------------------------------------------------------------------------

# Real MTN MoMo Collections API integration. Leave disabled until the merchant
# account, subscription key and API user are issued by MTN.
PAYMENTS_MTN_MOMO_ENABLED="false"
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_API_USER=""
MTN_MOMO_API_KEY=""
MTN_MOMO_TARGET_ENV="sandbox" # sandbox | mtnrwanda
MTN_MOMO_CALLBACK_URL="" # must be publicly reachable HTTPS URL
MTN_MOMO_CURRENCY="RWF"

# Airtel Money / card acquiring are NOT implemented. See docs/PAYMENTS.md.

# ---------------------------------------------------------------------------
# Email (optional). Without these values the application stores inquiries in
# the database and shows the honest "saved, not emailed" message.
# ---------------------------------------------------------------------------
EMAIL_FROM=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
